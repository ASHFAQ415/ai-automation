# AI Automation Platform ? Environment Configuration Template
# Copy this file to hermes/.env or backend/.env and populate with your credentials.
# NEVER commit actual secrets to version control.

APP_NAME="AI Lead Automation Platform"
APP_VERSION="3.0.0"
DEBUG=false
PORT=8000
HOST="0.0.0.0"
API_SECRET_KEY="change-me-to-a-secure-random-token"
TEST_MODE=false

# LLM Config
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:4b"
OLLAMA_FALLBACK_MODEL="qwen2.5:3b"
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"

# Telegram (@Preetikaa_bot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
TELEGRAM_ALLOWED_USERS=""

# WhatsApp
WHATSAPP_ENABLED=true
WHATSAPP_ALLOWED_USERS=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Discord
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_CHANNEL_ID=""
DISCORD_ALLOWED_USERS=""

# Email
EMAIL_ADDRESS=""
EMAIL_PASSWORD=""
EMAIL_IMAP_HOST="imap.gmail.com"
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT=587

# Payments (Razorpay & Stripe)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_API_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cloudflare Tunnels
CLOUDFLARE_TUNNEL_TOKEN=""
